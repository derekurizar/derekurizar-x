{
 "version": 1,
 "nota": "Lo escribe SOLO `python3 scripts/maqueta3d.py catalogo --registrar` desde las fichas video/maqueta/<clase>/<tipo>.json (no se edita a mano). Cómo añadir una entrada: referencias/diseno/maqueta3d.md («Añadir vocabulario»).",
 "entradas": [
  {
   "tipo": "falla",
   "clase": "pieza",
   "cuando": "una falla geológica que se rompe o se desliza (un terremoto): la traza del set o una dibujada",
   "parametros": {
    "trazos": {
     "tipo": "lista",
     "requerido": false,
     "descripcion": "nombres de trazos del set (design/sets3d/<set>/fallas.json → nombres); con `puntos`, al menos uno de los dos",
     "capa": "fallas"
    },
    "puntos": {
     "tipo": "puntos",
     "requerido": false,
     "min": 2,
     "descripcion": "el trazo propio, [[lon, lat], …] (la traza publicada de una ruptura)"
    },
    "suave": {
     "tipo": "bool",
     "requerido": false,
     "defecto": true,
     "descripcion": "suaviza los `puntos` con una curva (Catmull-Rom)"
    }
   },
   "escalas": [
    "pais"
   ],
   "motores": [
    "three",
    "blender"
   ],
   "ejemplo": {
    "id": "motagua",
    "tipo": "falla",
    "trazos": [
     "Motagua Fault"
    ]
   },
   "modulo": "piezas/falla.js",
   "reglas": "scripts/maqueta_tipos/falla.py"
  },
  {
   "tipo": "frontera",
