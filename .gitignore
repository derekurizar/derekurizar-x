# /video: el mp4 queda fuera de git (se regenera con /video); guion, srt, caption y PNG sí se versionan
hilos/*/video/*.mp4
# /noticias: igual, el mp4 del noticiero queda fuera de git
noticias/*/*.mp4
# /semana: igual, el mp4 de la semana queda fuera de git (guion.json con las cifras, fuentes.md y caption sí)
semanas/*/*.mp4
# /historia: igual, los mp4 de la historia quedan fuera de git (las fotos ni siquiera se copian: son de terceros)
historias/*/*.mp4
# /explica: igual, los mp4 del video explicativo quedan fuera de git
explicaciones/*/*.mp4
# /sabias: igual, el mp4 del «¿Sabías que…?» queda fuera de git (guion, srt, caption y PNG sí se versionan)
datos/*/video/*.mp4
