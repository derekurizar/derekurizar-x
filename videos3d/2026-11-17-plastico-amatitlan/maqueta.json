            "hecho": "comparacion-h02"
          },
          {
            "que": "la caja del Palacio, 127 × 70 × 30 m",
            "hecho": "comparacion-h01"
          },
          {
            "que": "el Palacio de color verde (sin afirmar material ni tono exacto)",
            "hecho": "visual-palacio-h01"
          },
          {
            "que": "corredores y detalles decorativos de la fachada, sin número ni forma de patios",
            "hecho": "visual-palacio-h02"
          },
          {
            "que": "30 m de alto con tres pisos sobre el suelo más la terraza, sin torre ni reloj",
            "hecho": "visual-palacio-h03"
          },
