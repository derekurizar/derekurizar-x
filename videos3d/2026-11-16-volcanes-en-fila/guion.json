  "estilo": {
    "id": "noche",
    "razon": "La idea visual es una sola cosa encendida (los cráteres de la fila y el magma que sube) sobre un país y una Tierra a oscuras; noche lo da en los tres mundos y el brillo del magma en el corte solo se lee sobre fondo oscuro. color pierde el acento único; plano sirve al mecanismo pero apaga el magma y obliga a preguntar por las capas.",
    "confianza": "alta",
    "candidatos": [
      "noche",
      "plano",
      "color"
    ]
  },
